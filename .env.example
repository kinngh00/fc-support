# 새로 발급한 키만 쉼표로 구분해 입력하세요. 실제 .env 파일은 Git에 저장되지 않습니다.
NEXON_API_KEYS=
FC_ADMIN_TOKEN=
FC_SCHEDULER_ENABLED=true
FC_COLLECT_ON_EMPTY=true
FC_API_CONCURRENCY_PER_KEY=2
FC_RANKING_CONCURRENCY=5
FC_BACKEND_HOST=127.0.0.1
FC_BACKEND_PORT=8787
FC_DB_PATH=data/fc-support.db
FC_FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
